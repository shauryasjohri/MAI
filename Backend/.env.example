NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb://localhost:27017/mai
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
COOKIE_NAME=mai_token
# Set these when the frontend and backend are on different sites over HTTPS:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none

# RAG / document uploads
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
MAX_UPLOAD_MB=10
MAX_DOCUMENTS_PER_THREAD=5

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
OAUTH_SUCCESS_REDIRECT=http://localhost:5173
